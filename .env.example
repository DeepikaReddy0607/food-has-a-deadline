# ==========================================
# FOOD HAS A DEADLINE (FHD) — ENVIRONMENT TEMPLATE
# ==========================================

# --- Backend Configuration ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/food_has_a_deadline
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
OSRM_BASE_URL=http://router.project-osrm.org

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8000

# --- Docker Compose / PostgreSQL Credentials ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=food_has_a_deadline
POSTGRES_PORT=5432
